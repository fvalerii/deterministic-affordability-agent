# Copy this file to `.env` and replace the placeholder with your Anthropic API key.
# `.env` is gitignored and must never be committed.

ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional model overrides (Claude Sonnet; 3.5 IDs are retired on the current API)
ANTHROPIC_VISION_MODEL=claude-sonnet-4-6
ANTHROPIC_EXPLANATION_MODEL=claude-sonnet-4-6
